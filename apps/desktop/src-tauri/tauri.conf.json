{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gopass-desktop",
  "version": "0.1.0",
  "identifier": "dev.yoophi.gopass-desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "gopass-desktop", "width": 900, "height": 640 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
